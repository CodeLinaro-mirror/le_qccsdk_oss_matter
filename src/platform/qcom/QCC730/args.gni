# GN build arguments for the QCC730 chip (Cortex-M33, Zephyr RTOS, WiFi-only).

chip_device_platform = "qcom"

chip_enable_wifi = true
chip_enable_ble  = false

chip_mdns = "minimal"

declare_args() {
  # Use Zephyr sys_heap for chip::Platform::MemoryAlloc.
  chip_malloc_sys_heap = false
}
