# Platform layer for Qualcomm Zephyr-based Matter chips.
#
# Directory layout:
#   common/   — chip-independent sources shared by all qcom chips
#   QCC730/   — QCC730-specific overrides (CHIPDevicePlatformConfig.h, args.gni, wifi driver)
#   QCC740/   — future chip (placeholder)
#
# The :qcom target is the active chip's platform library.
# The :logging target is shared across all qcom chips.

import("//build_overrides/chip.gni")
import("//build_overrides/zephyr.gni")

import("${chip_root}/src/platform/device.gni")
import("${chip_root}/src/platform/qcom/QCC730/args.gni")

assert(chip_device_platform == "qcom")

static_library("qcom") {
  sources = [
    # ── Zephyr shared sources ──────────────────────────────────────────────
    "../SingletonConfigurationManager.cpp",
    "../Zephyr/ConfigurationManagerImpl.cpp",
    "ConfigurationManagerImpl.h",
    "../Zephyr/DeviceInstanceInfoProviderImpl.cpp",
    "DeviceInstanceInfoProviderImpl.h",
    "../Zephyr/DiagnosticDataProviderImpl.cpp",
    "DiagnosticDataProviderImpl.h",
    "../Zephyr/InetUtils.cpp",
    "../Zephyr/InetUtils.h",
    "../Zephyr/KeyValueStoreManagerImpl.cpp",
    "KeyValueStoreManagerImpl.h",
    "../Zephyr/PlatformManagerImpl.cpp",
    "../Zephyr/SysHeapMalloc.h",
    "../Zephyr/SystemTimeSupport.cpp",
    "../Zephyr/ZephyrConfig.cpp",
    "../Zephyr/ZephyrConfig.h",

    # ── qcom/common: chip-independent platform sources ─────────────────────
    "BlePlatformConfig.h",
    "CHIPDevicePlatformEvent.h",
    "CHIPPlatformConfig.h",
    "common/ConnectivityManagerImpl.cpp",
    "ConnectivityManagerImpl.h",
    "InetPlatformConfig.h",
    "PlatformManagerImpl.h",
    "SystemPlatformConfig.h",

    # ── QCC730-specific overrides ──────────────────────────────────────────
    "CHIPDevicePlatformConfig.h",
  ]

  public_deps = [ "${chip_root}/src/platform:platform_base" ]

  deps = [
    "${chip_root}/src/app:app_config",
    "${chip_root}/src/app/common:ids",
    "${chip_root}/src/platform/logging:headers",
  ]

  # WiFi support: reuse the generic Zephyr WiFi layer plus the QCC730 driver wrapper.
  if (chip_enable_wifi) {
    sources += [
      "../Zephyr/wifi/ConnectivityManagerImplWiFi.cpp",
      "../Zephyr/wifi/ConnectivityManagerImplWiFi.h",
      "../Zephyr/wifi/DiagnosticDataProviderImplWiFi.cpp",
      "../Zephyr/wifi/DiagnosticDataProviderImplWiFi.h",
      "../Zephyr/wifi/WiFiManager.cpp",
      "../Zephyr/wifi/WiFiManager.h",
      "../Zephyr/wifi/ZephyrWifiDriver.cpp",
      "../Zephyr/wifi/ZephyrWifiDriver.h",
      "QCC730/wifi/QComWifiDriver.h",
    ]
  } else {
    sources += [ "../Zephyr/DiagnosticDataProviderImplGetter.cpp" ]
  }

  if (chip_malloc_sys_heap) {
    sources += [ "../Zephyr/SysHeapMalloc.cpp" ]
  }

  if (chip_enable_ota_requestor) {
    sources += [
      "../Zephyr/OTAImageProcessorImpl.cpp",
      "../Zephyr/OTAImageProcessorImpl.h",
    ]
  }

  cflags = [
    "-Wconversion",
    "-include",
    "assert.h",
  ]
}

source_set("logging") {
  deps = [
    "${chip_root}/src/platform:platform_base",
    "${chip_root}/src/platform/logging:headers",
  ]
  sources = [ "../Zephyr/Logging.cpp" ]
}
